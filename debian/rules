#!/usr/bin/make -f

%:
	dh $@

# There's no declarative debhelper way to say "patch a file owned by
# another package" (Main.qml belongs to lliurex-sddm-theme), so this
# project's own scripts/install.sh and scripts/uninstall.sh already do
# that imperatively (version/sha256 check, backup, copy). Rather than
# re-implement that logic as debhelper maintainer-script snippets, ship
# the whole repo under /usr/share/lliurex-access-explainer/ and have
# postinst/prerm call those same scripts directly - one source of
# truth, same behavior whether installed by hand or via this package.
override_dh_install:
	mkdir -p debian/lliurex-access-explainer/usr/share/lliurex-access-explainer
	rsync -a --chmod=D755,F644 \
		--exclude='.git/' \
		--exclude='.gitignore' \
		--exclude='debian/' \
		--exclude='__pycache__/' \
		--exclude='.pytest_cache/' \
		--exclude='AGENTS.md' \
		./ debian/lliurex-access-explainer/usr/share/lliurex-access-explainer/
	chmod 755 \
		debian/lliurex-access-explainer/usr/share/lliurex-access-explainer/diagnose/diagnose_login_wifigva.sh \
		debian/lliurex-access-explainer/usr/share/lliurex-access-explainer/scripts/install.sh \
		debian/lliurex-access-explainer/usr/share/lliurex-access-explainer/scripts/uninstall.sh \
		debian/lliurex-access-explainer/usr/share/lliurex-access-explainer/scripts/build-release.sh \
		debian/lliurex-access-explainer/usr/share/lliurex-access-explainer/sddm-theme-patch/apply_patch.py
	dh_install
